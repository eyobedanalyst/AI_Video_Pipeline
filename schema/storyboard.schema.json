{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Storyboard",
    "type": "object",
    "required": ["version", "title", "audience", "intent", "language", "global_seed", "style_block", "character", "narration", "music", "shots", "end_card", "export"],
    "properties": {
      "version": { "type": "string" },
      "title": { "type": "string" },
      "logline": { "type": "string" },
      "audience": { "type": "string", "minLength": 5 },
      "intent": { "type": "string", "minLength": 5 },
      "language": { "type": "string" },
      "global_seed": { "type": "integer" },
      "aspect_ratios": { "type": "array", "items": { "enum": ["9:16", "16:9"] } },
      "style_block": { "type": "string", "minLength": 5 },
      "character": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string", "minLength": 10 },
          "reference_image": { "type": "string" }
        }
      },
      "narration": {
        "type": "object",
        "required": ["tts_model", "voice", "style_instruction"],
        "properties": {
          "tts_model": { "type": "string" },
          "voice": { "type": "string" },
          "style_instruction": { "type": "string" },
          "subtitle_language": { "type": "string" }
        }
      },
      "music": {
        "type": "object",
        "required": ["caption", "instrumental", "bpm", "key", "duration_sec", "cues"],
        "properties": {
          "caption": { "type": "string" },
          "instrumental": { "type": "boolean" },
          "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
          "key": { "type": "string" },
          "duration_sec": { "type": "integer", "minimum": 10 },
          "candidates": { "type": "integer", "minimum": 1 },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from_shot", "to_shot", "role"],
              "properties": {
                "from_shot": { "type": "integer" },
                "to_shot": { "type": "integer" },
                "role": { "type": "string" }
              }
            }
          }
        }
      },
      "shots": {
        "type": "array",
        "minItems": 8,
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["id", "duration_sec", "reason", "keyframe_prompt", "motion_prompt", "camera", "narration"],
          "properties": {
            "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
            "duration_sec": { "type": "number", "minimum": 3, "maximum": 12 },
            "shot_size": { "type": "string" },
            "time_label": { "type": "string" },
            "reason": { "type": "string", "minLength": 5 },
            "keyframe_prompt": { "type": "string", "minLength": 10 },
            "motion_prompt": { "type": "string" },
            "camera": { "enum": ["static", "push_in", "zoom_out", "pan_left", "pan_right"] },
            "narration": { "type": "string", "minLength": 3 },
            "sfx": { "type": "string" },
            "seed": { "type": "integer" }
          }
        }
      },
      "end_card": {
        "type": "object",
        "required": ["duration_sec", "lines"],
        "properties": {
          "duration_sec": { "type": "number" },
          "lines": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      },
      "export": {
        "type": "object",
        "required": ["fps", "loudness_lufs", "targets"],
        "properties": {
          "fps": { "type": "integer" },
          "loudness_lufs": { "type": "number" },
          "true_peak_db": { "type": "number" },
          "subtitles": { "type": "object" },
          "targets": { "type": "array", "items": { "type": "object", "required": ["aspect", "size", "file"] } }
        }
      }
    }
  }